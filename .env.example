# ═══════════════════════════════════════════════════════
#  Feishu App Credentials
#  Get these from: https://open.feishu.cn/app
# ═══════════════════════════════════════════════════════
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ═══════════════════════════════════════════════════════
#  Bitable App Tokens (generated by: npm run setup)
# ═══════════════════════════════════════════════════════
BITABLE_APP_TOKEN=

# Table IDs (filled in after npm run setup)
TABLE_INVENTORY=
TABLE_USERS=
TABLE_REQUESTS=
TABLE_ASSIGNMENTS=
TABLE_RETURNS=
TABLE_AUDIT_LOG=
TABLE_DUPLICATE_LOG=
TABLE_AMENDMENTS=
TABLE_NOTIFICATIONS=

# ═══════════════════════════════════════════════════════
#  JWT Auth
# ═══════════════════════════════════════════════════════
JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_EXPIRES_IN=8h

# ═══════════════════════════════════════════════════════
#  Email (Nodemailer — use SMTP or Gmail OAuth)
# ═══════════════════════════════════════════════════════
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your_app_password
EMAIL_FROM="Device Inventory System <your@email.com>"

# ═══════════════════════════════════════════════════════
#  Server
# ═══════════════════════════════════════════════════════
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
